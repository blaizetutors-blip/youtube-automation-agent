# Blaize Tutors Biology profile
# Copy this file to .env, then add your own keys locally. Never commit .env.

NODE_ENV=production
PORT=3456
LOG_LEVEL=info

BLAIZE_BIOLOGY_MODE=true
REQUIRE_HUMAN_APPROVAL=true
CHANNEL_NAME=Blaize Tutors
TARGET_AUDIENCE=Secondary-school learners preparing for WAEC, NECO, UTME/JAMB, IGCSE and GCSE
YOUTUBE_REGION=NG
AUTOMATION_TIMEZONE=Africa/Lagos

# Safe pilot mode: approval permits a private upload, not public release.
DEFAULT_PRIVACY_STATUS=private
AUTO_PUBLIC_SCHEDULING=false

# Required: generate a long random value locally.
API_KEY=

# Pick one AI provider and add the key locally.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# AI_PROVIDER_ORDER=gemini,groq,openai,openrouter,kimi,mimo,glm
# AI_PROVIDER_COOLDOWN_MS=900000
# GEMINI_TRANSIENT_RETRIES_PER_MODEL=1
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
# MOONSHOT_API_KEY=
# MIMO_API_KEY=
# GLM_API_KEY=

# Durable retries preserve validated checkpoints through quota/capacity outages.
# GENERATION_JOB_MAX_RETRIES=12
# GENERATION_JOB_RETRY_BASE_MS=60000
# GENERATION_JOB_RETRY_CAP_MS=900000

# Topic playlists are created as private and populated after each successful upload.
AUTO_MANAGE_PLAYLISTS=true
YOUTUBE_PLAYLIST_PRIVACY=private

# Optional premium narration.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional FFmpeg override. npm install already provides ffmpeg-static.
# FFMPEG_PATH=
