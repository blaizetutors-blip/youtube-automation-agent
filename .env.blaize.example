# Blaize Tutors Biology profile
# Copy this file to .env, then add your own keys locally. Never commit .env.

NODE_ENV=production
PORT=3456
LOG_LEVEL=info

BLAIZE_BIOLOGY_MODE=true
REQUIRE_HUMAN_APPROVAL=true
CHANNEL_NAME=Blaize Tutors
TARGET_AUDIENCE=Secondary-school learners preparing for WAEC, NECO, UTME/JAMB, IGCSE and GCSE
YOUTUBE_REGION=NG
AUTOMATION_TIMEZONE=Africa/Lagos

# Safe pilot mode: approval permits a private upload, not public release.
DEFAULT_PRIVACY_STATUS=private
AUTO_PUBLIC_SCHEDULING=false

# Required: generate a long random value locally.
API_KEY=

# Pick one AI provider and add the key locally.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# MIMO_API_KEY=
# GLM_API_KEY=

# Optional premium narration.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional FFmpeg override. npm install already provides ffmpeg-static.
# FFMPEG_PATH=
